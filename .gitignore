# ===============
# Unity generated files
# ===============
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Avoid importing user-specific settings
UserSettings/

# ===============
# Visual Studio / Rider
# ===============
.vs/
*.sln*
*.csproj
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
.codemodel*

# Rider specific
.idea/
*.iml

# ===============
# OS-specific files
# ===============
.DS_Store
Thumbs.db

# ===============
# Packages
# ===============
Packages/
manifest.json
packages-lock.json

# Prevent committing package lock files unless intentionally tracking dependencies
!Packages/manifest.json

# ===============
# Logs and local caches
# ===============
*.log
*.gid

# Autogenerated files
*.csproj
*.pidb
*.suo
*.tmp
*.userprefs
*.bak
*.swp

# Exclude Play mode test results
Assets/StreamingAssets/UnityPlayModeTestResults/

# Exclude Burst compiler debug information
[Bb]urstDebugInformation/

# Custom Folders (Based on Your Structure)
Assets/Animations/*.meta
Assets/Audio/*.meta
Assets/Characters/*.meta
Assets/LowPoly Enviro/*.meta
Assets/Materials/*.meta
Assets/Scenes/*.meta
Assets/Scripts/*.meta
Assets/Textures/*.meta
Assets/InputSystem_A/*.meta
Assets/New Lighting S/*.meta

# Ignore compiled C# files
Assets/Scripts/*.csproj

# Ignore Temp Meta files
*.meta
